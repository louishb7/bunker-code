{
  "name": "bunker-code",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "scripts": {
    "analyze": "node --import tsx apps/cli/src/main.ts analyze",
    "impact": "node --import tsx apps/cli/src/main.ts impact",
    "explorer": "node --import tsx apps/explorer-web/scripts/develop.ts",
    "typecheck": "./node_modules/.bin/tsc -p packages/contracts/tsconfig.json --noEmit && ./node_modules/.bin/tsc -p packages/analyzer-typescript/tsconfig.json --noEmit && ./node_modules/.bin/tsc -p packages/graph-engine/tsconfig.json --noEmit && ./node_modules/.bin/tsc -p apps/cli/tsconfig.json --noEmit && ./node_modules/.bin/tsc -p apps/explorer-web/tsconfig.json --noEmit",
    "test": "node --import tsx --test test/analyze-simple-import.test.ts test/project-discovery.test.ts test/project-graph.test.ts test/investigate-cli.test.ts test/browser-graph-engine.test.ts test/explorer-web.test.ts test/explorer-web-browser.test.ts test/responsibility-contract.test.ts test/responsibility-runtime.test.ts",
    "test:browser": "BUNKERCODE_BROWSER_TEST=1 node --import tsx --test test/browser-graph-engine.test.ts test/explorer-web-browser.test.ts"
  },
  "devDependencies": {
    "@bunker-code/contracts": "workspace:*",
    "@bunker-code/graph-engine": "workspace:*",
    "@types/node": "^24.1.0",
    "esbuild": "0.28.1",
    "puppeteer-core": "^25.8.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
